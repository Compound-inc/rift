{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rift-markdown-converter",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-25",
  "ai": {
    "binding": "AI",
  },
  // Enable Workers Logs so runtime logs and uncaught exceptions are captured
  // in the Cloudflare dashboard. `head_sampling_rate: 1` keeps 100% of
  // invocations — safe here because this worker is low-traffic.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
